# Askirawa Finance Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env or any file containing secret values.

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Treasury v2 (testnet only until audited). All values below are public identifiers, not secrets.
# Target chain. Default 5042002 (Arc Testnet). Do not point v2 at mainnet before an independent audit.
VITE_CHAIN_ID=5042002
# Deployed AskirawaTreasury and RecurringPaymentModule (from the DeployTreasuryV2 script output).
# The app shows a configuration banner and no treasury data until VITE_TREASURY_ADDRESS is set.
# WalletConnect (Reown) project ID, needed for phone wallet apps. Public, not a secret.
# Get one at https://cloud.reown.com. On Vercel add it under Settings > Environment
# Variables, then redeploy: Vite reads it at build time.
VITE_WC_PROJECT_ID=

VITE_TREASURY_ADDRESS=
VITE_RECURRING_MODULE_ADDRESS=
# Deployed TreasuryRecovery (printed by the deploy script; the treasury's recovery() returns the same address).
VITE_RECOVERY_ADDRESS=
# Block number of the treasury deployment receipt. Event history scans start here (never block 0).
VITE_TREASURY_DEPLOY_BLOCK=

# ── Backend server ────────────────────────────────────────────────────────────
# Required: random secret for session cookies (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server exits on startup if this is absent when NODE_ENV=production.
SESSION_SECRET=

# Optional: SQLite database file path (default: ./askira.db)
# DATABASE_URL=./askira.db

# Optional: server port (default: 3001)
# PORT=3001

# ── Keeper worker (Treasury v2) ───────────────────────────────────────────────
# Dedicated gas-only wallet that calls RecurringPaymentModule.execute(id).
# It has no governance power and cannot move funds on its own. Keep its balance small.
# The value is a secret: put it only in your private .env, never in chat, logs or source.
KEEPER_PRIVATE_KEY=

# Optional keeper tuning
# POLL_INTERVAL_MS=60000
# MAX_SCHEDULES_PER_POLL=20
# MAX_SCAN=500
# RETRY_MAX=2
# RECEIPT_TIMEOUT_MS=90000
# The keeper refuses chain 5042 (mainnet) unless KEEPER_ALLOW_MAINNET=yes. Leave unset.

# ── Arc Studio RPC proxy (auto-provisioned inside Arc Studio) ─────────────────
# Set automatically inside Arc Studio. Leave blank outside Arc Studio.
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
