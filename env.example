# Askirawa Finance Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env or any file containing secret values.

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Deployed AskirawaFiTreasury address on Arc Mainnet (chain ID 5042).
# Set this after running the DeployTreasury script.
# The frontend shows a configuration banner and disables all transactions until this is set.
# WalletConnect (Reown) project ID, needed for phone wallet apps. Public, not a secret.
# Get one at https://cloud.reown.com. On Vercel add it under Settings > Environment
# Variables, then redeploy: Vite reads it at build time.
VITE_WC_PROJECT_ID=

VITE_TREASURY_ADDRESS=

# ── Backend server ────────────────────────────────────────────────────────────
# Required: random secret for session cookies (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server exits on startup if this is absent when NODE_ENV=production.
SESSION_SECRET=

# Optional: SQLite database file path (default: ./askira.db)
# DATABASE_URL=./askira.db

# Optional: server port (default: 3001)
# PORT=3001

# ── Keeper worker ─────────────────────────────────────────────────────────────
# Private key (0x...) of the EOA set as the treasury keeper.
# This wallet needs USDC on Arc Mainnet for gas. Never commit this value.
KEEPER_PRIVATE_KEY=

# Optional keeper tuning
# POLL_INTERVAL_MS=60000
# MAX_SCHEDULES_PER_POLL=20
# RETRY_MAX=1

# ── Arc Studio RPC proxy (auto-provisioned inside Arc Studio) ─────────────────
# Set automatically inside Arc Studio. Leave blank outside Arc Studio.
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
