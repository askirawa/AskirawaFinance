{
  "name": "@circle-fin/onramp-kit",
  "version": "1.0.3",
  "description": "Official Circle SDK for embedding the Arc Onramp widget — server-side session creation and client-side widget mounting.",
  "keywords": [
    "circle",
    "circle-fin",
    "usdc",
    "stablecoin",
    "sdk",
    "typescript",
    "onramp",
    "fiat-to-crypto",
    "widget",
    "iframe",
    "arc",
    "usdc-sdk",
    "onramp-kit"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "dependencies": {
    "zod": "3.25.67",
    "pino": "10.1.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": {
        "import": "./index.d.mts",
        "require": "./index.d.cts"
      },
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./server": {
      "types": {
        "import": "./server.d.mts",
        "require": "./server.d.cts"
      },
      "import": "./server.mjs",
      "require": "./server.cjs",
      "default": "./server.cjs"
    },
    "./protocol": {
      "types": {
        "import": "./protocol.d.mts",
        "require": "./protocol.d.cts"
      },
      "import": "./protocol.mjs",
      "require": "./protocol.cjs",
      "default": "./protocol.cjs"
    },
    "./mocks": {
      "types": {
        "import": "./mocks.d.mts",
        "require": "./mocks.d.cts"
      },
      "import": "./mocks.mjs",
      "require": "./mocks.cjs",
      "default": "./mocks.cjs"
    }
  },
  "files": [
    "index.*",
    "server.*",
    "protocol.*",
    "mocks.*",
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}