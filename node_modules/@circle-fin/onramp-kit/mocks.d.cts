    /** OnRamp loaded successfully and is waiting for user input. */
    readonly INITIALIZATION_SUCCESS: "INITIALIZATION_SUCCESS";
    /** The deposit flow ended without a settled deposit. See `code`. */
    readonly DEPOSIT_NOT_COMPLETED: "DEPOSIT_NOT_COMPLETED";
    /** The customer submitted a deposit request. */
    readonly DEPOSIT_SUBMITTED: "DEPOSIT_SUBMITTED";
