    readonly SESSION_TIMEOUT: "SESSION_TIMEOUT";
    /** The customer chose not to complete the deposit. */
    readonly CANCELED_BY_CUSTOMER: "CANCELED_BY_CUSTOMER";
    /** No eligible payment options were available for the customer or region. */
