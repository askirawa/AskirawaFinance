    readonly PAYMENT_PROVIDER_ERROR: "PAYMENT_PROVIDER_ERROR";
    /** The customer submitted a deposit request. */
    readonly DEPOSIT_SUBMITTED: "DEPOSIT_SUBMITTED";
    /** A previously submitted deposit settled on-chain. */
    readonly DEPOSIT_SETTLED: "DEPOSIT_SETTLED";
