/**
 * Create a union type that preserves IDE autocomplete for known string
 * literals while still accepting any other string.
 *
 * @remarks
 * `T | (string & Record<never, never>)` keeps editor autocomplete for
 * the known members of `T` without TypeScript widening the whole union
 * down to `string`. Use it for values sourced from an external system
 * that may legitimately add new members over time (wire-protocol event
 * codes, chain identifiers, token symbols, …), so a brand-new value
 * still type-checks instead of becoming a compile error.
 *
 * `Record<never, never>` is used instead of the bare `{}` so the
 * `@typescript-eslint/ban-types` rule stays satisfied.
 *
 * @typeParam T - The known string-literal union to preserve.
 *
 * @example
 * ```typescript
 * type PaymentMethod = LiteralUnion<'ApplePay' | 'GooglePay'>
 *
 * const a: PaymentMethod = 'ApplePay' // autocompleted
 * const b: PaymentMethod = 'PixQr' // still allowed (future value)
 * ```
 *
 * @since 0.0.1
 */
type LiteralUnion<T extends string> = T | (string & Record<never, never>);

/**
 * Typed `{ event, code, payload }` envelopes for the host ↔ widget
