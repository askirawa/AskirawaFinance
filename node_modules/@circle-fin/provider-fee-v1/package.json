{
  "name": "@circle-fin/provider-fee-v1",
  "version": "0.3.2",
  "description": "Client for Circle's Quote API that fetches signed fee quotes for the prepaid FORWARD fast-deposit path of a CCTP v2 USDC burn.",
  "keywords": [
    "circle",
    "circle-fin",
    "usdc",
    "cctp",
    "fee",
    "quote",
    "provider",
    "typescript"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "dependencies": {
    "zod": "3.25.67",
    "@ethersproject/abi": "^5.8.0",
    "@ethersproject/address": "^5.8.0",
    "@ethersproject/bytes": "^5.8.0",
    "@ethersproject/units": "^5.8.0",
    "bs58": "6.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": {
        "import": "./index.d.mts",
        "require": "./index.d.cts"
      },
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "files": [
    "index.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  }
}