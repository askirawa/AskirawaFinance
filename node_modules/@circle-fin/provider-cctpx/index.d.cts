declare const KNOWN_TOKEN_SYMBOLS: readonly ["cirBTC", "wETH", "EURC"];
/**
 * A known token symbol. Derived from {@link KNOWN_TOKEN_SYMBOLS} so the
 * type and the runtime set never drift.
 *
 * @example
 * ```typescript
 * const sym: KnownTokenSymbol = 'cirBTC'
 * ```
 */
