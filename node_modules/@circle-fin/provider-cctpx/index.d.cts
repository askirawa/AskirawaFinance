     * ```
     */
    retry<TFromAdapterCapabilities extends AdapterCapabilities, TToAdapterCapabilities extends AdapterCapabilities>(result: BridgeResult<CCTPXTokenId>, context: RetryContext<TFromAdapterCapabilities, TToAdapterCapabilities>, invocationMeta?: InvocationMeta): Promise<BridgeResult<CCTPXTokenId>>;
    /**
     * Resolve a recorded transfer's actual on-chain outcome.
     *
     * The step state alone cannot answer this. A transaction hash is derived from
     * the signed payload, so a step can carry one for a transaction that was
     * never mined, was dropped from the mempool, or was replaced by a same-nonce
     * speed-up or cancellation. Driving the destination leg in those cases polls
     * IRIS for a message that will never be indexed. The chain is the only
     * authority, so it is consulted before any resume.
     *
     * Only the two *terminal* outcomes throw. "Still unconfirmed" is returned
     * rather than thrown so the caller can hand back a `BridgeResult` that still
     * carries the in-flight transfer hash — a throw would strip it, and would
     * skip the kit's step-error telemetry.
