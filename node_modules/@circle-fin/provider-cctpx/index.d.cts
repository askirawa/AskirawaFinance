    estimate<TFromAdapterCapabilities extends AdapterCapabilities, TToAdapterCapabilities extends AdapterCapabilities>(params: BridgeParams<TFromAdapterCapabilities, TToAdapterCapabilities, ChainDefinition, CCTPXRouteToken>): Promise<EstimateResult<CCTPXTokenId, string, QuoteEnvelope>>;
    /**
     * Request a fresh attestation for a stuck CCTPx message and return it once
     * Circle re-signs it.
     *
     * Used when an original attestation could not be delivered before the
     * destination forward completed. The method resolves the message nonce from
     * the source transaction hash, posts to the IRIS re-attestation endpoint for
     * that nonce, then re-polls the IRIS messages endpoint until the refreshed
     * attestation reports `complete`. It performs three steps:
     *
     * 1. Poll the source message until its attestation is available, then read
     *    its event nonce.
     * 2. Request re-attestation from the IRIS API using that nonce.
     * 3. Re-poll for the refreshed attestation and return it.
     *
     * @typeParam TFromAdapterCapabilities - The capabilities of the source
     *   adapter.
     * @typeParam TToAdapterCapabilities - The capabilities of the destination
     *   adapter.
     * @param source - The source wallet context; its chain must be a CCTPx
     *   route endpoint carrying a CCTP domain.
     * @param transactionHash - The source-chain transaction hash whose
     *   attestation is being refreshed.
