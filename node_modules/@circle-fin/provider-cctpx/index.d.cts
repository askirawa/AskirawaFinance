/**
 * Base payload structure shared by every CCTPx action event.
 *
 * Every action carries the protocol identifier plus an optional trace id
 * so a single bridge operation's events can be correlated end to end. The
 * concrete per-action fields are added by each entry in
 * {@link CCTPXActions} via `method` + `values`.
 */
interface CCTPXActionBase {
    /** The protocol identifier. */
    protocol: 'cctpx';
    /** The protocol version. */
    version: 'v1';
    /**
     * Optional trace id for end-to-end correlation across the events of a
     * single bridge operation (e.g. an OpenTelemetry trace id). When
     * provided, every action emitted for the operation carries the same id.
     */
    traceId?: string;
}
/**
 * Lifecycle state of a forward request as reported by the IRIS API.
 *
 * A `FAILED` forward does not reach the `forward` action at all — the poll
 * throws, and the reported code and detail ride on that error's trace.
 *
 * Terminal states end the destination-delivery poll:
 *
 * - `CONFIRMED` — the delivery transaction is mined and the funds are
 *   spendable; destination finality is still pending. Terminal once the
 *   relayer also reports a `forwardTxHash` — the poll resolves here rather
 *   than holding the caller for finality.
 * - `COMPLETE` — the destination delivery succeeded with finality.
 * - `FAILED` — the forward failed; the transfer did not deliver.
 *
 * Non-terminal states keep the poll running:
 *
 * - `PENDING` / `SENT` — the forward is in progress.
 *
 * @remarks
 * The union admits only the states the IRIS forward endpoint reports. It
 * does not include `SUBMITTED` or `EXPIRED`: those are not emitted by the
 * forward state machine and are not part of this type. A gas-pause and a
 * cancellation are likewise not observable — the API reports them as
 * `PENDING` and `FAILED` respectively before returning. A consumer matching
 * on this union should handle the values listed above and no others.
 *
 * @example
 * ```typescript
 * const state: CCTPXForwardState = 'CONFIRMED'
 * ```
 */
type CCTPXForwardState = 'PENDING' | 'SENT' | 'CONFIRMED' | 'COMPLETE' | 'FAILED';
/**
 * Attestation status reported by the IRIS `/v2/messages/{sourceDomain}`
 * endpoint for a CCTPx source-chain message.
 *
 * The attestation poll resolves only on `'complete'`; `'pending'` is the
 * in-progress status returned while Circle signs the attestation. These
 * are the only two values the poller observes and emits, matching the
 * status vocabulary the same endpoint uses for CCTP v2 messages.
 *
 * @example
 * ```typescript
 * const status: CCTPXAttestationStatus = 'complete'
 * ```
 */
type CCTPXAttestationStatus = 'pending' | 'complete';
/**
 * Type-level map of CCTPx action names to their event payloads.
 *
 * Mirrors the wrapper shape of the CCTP v2 action map (`method` + `values`
 * over a shared protocol-metadata base) so the kit's action-merging types
 * and `kit.on(action, handler)` work uniformly across providers. The
 * entries follow the bridge flow:
 *
 * - `approve` — ERC-20 approve on the token's TokenManager.
 * - `approveFee` — ERC-20 approve granting the CCTS service contract an
 *   allowance for an ERC-20 protocol fee. Emitted only when the fee is paid
 *   in an ERC-20 token; a native fee rides as `msg.value` and needs none.
 * - `transfer` — the `crossChainTransfer` call on the source chain.
 *   Named `transfer` (not `burn`) because the source-chain action is
 *   lock-or-burn depending on the token.
 * - `fetchAttestation` — the IRIS attestation poll.
 * - `forward` — the destination-side delivery poll. Named `forward` (not
 *   `mint`) because the destination action is mint-or-unlock and aligns
 *   with the IRIS `forwardState` / forward-fee terminology.
 * - `reAttest` — re-attestation flow for a stuck message.
 *
 * @example
 * ```typescript
 * const action: CCTPXActions['transfer'] = {
 *   protocol: 'cctpx',
 *   version: 'v1',
 *   method: 'transfer',
 *   values: {
 *     chain: 'Arc_Testnet',
 *     transactionHash: '0xabc...',
 *     tokenId:
 *       '0x0000000000000000000000000000000000000000000000000000000063697254',
 *     amount: '1000000',
 *   },
 * }
 * ```
 */
interface CCTPXActions {
    /**
     * Approve action: ERC-20 approve granting the token's TokenManager an
     * allowance before `crossChainTransfer`.
     */
    approve: CCTPXActionBase & {
        method: 'approve';
        values: {
            /** Chain identifier the approval was submitted on. */
            chain: string;
            /** Hash of the approval transaction. */
            transactionHash: string;
        };
    };
    /**
     * Fee-approve action: an ERC-20 approve granting the CCTS service contract
     * an allowance for an ERC-20 protocol fee, submitted before
     * `crossChainTransfer`. Present only when the protocol fee is paid in an
     * ERC-20 token — a native fee rides as `msg.value` and needs no approve.
     */
    approveFee: CCTPXActionBase & {
        method: 'approveFee';
        values: {
            /** Chain identifier the fee approval was submitted on. */
            chain: string;
            /** Hash of the fee-approval transaction. */
            transactionHash: string;
        };
    };
    /**
     * Transfer action: the `crossChainTransfer` call that locks or burns the
     * token on the source chain.
     */
    transfer: CCTPXActionBase & {
        method: 'transfer';
        values: {
            /** Chain identifier the transfer was submitted on. */
            chain: string;
            /** Hash of the transfer transaction. */
            transactionHash: string;
            /** The bytes32 CCTPx token id that was transferred. */
            tokenId: CCTPXTokenId;
            /** Transferred amount in the token's atomic units. */
            amount: string;
        };
    };
    /**
     * Attestation action: the result of polling the IRIS API for the
     * source-chain message attestation.
     */
    fetchAttestation: CCTPXActionBase & {
        method: 'fetchAttestation';
        values: {
            /** The attestation envelope returned by the IRIS API. */
            attestation: string;
            /**
             * The attestation status reported by the IRIS API. Narrowed to the
             * concrete vocabulary the attestation poller emits — see
             * {@link CCTPXAttestationStatus}. The success-path dispatch always
             * carries `'complete'`; `'pending'` represents an in-progress poll.
             */
            status: CCTPXAttestationStatus;
        };
    };
    /**
     * Forward action: the destination delivery landed — `values.forwardState`
     * says whether finality has followed. `errorCode` / `errorDetails` carry a
     * reported cause when one is present.
     */
    forward: CCTPXActionBase & {
        method: 'forward';
        values: {
            /** Destination chain identifier. */
            chain: string;
            /**
             * Hash of the relayer's destination delivery transaction, when the
             * relayer reported one.
             */
            transactionHash?: string;
            /**
             * The forward state reported by the IRIS API — see
             * {@link CCTPXForwardState}. The dispatch carries `'CONFIRMED'` or
             * `'COMPLETE'`, whichever the poll resolved on. The union stays wide
             * because the payload can also model a failure, which `errorCode` /
             * `errorDetails` below exist for.
             */
            forwardState: CCTPXForwardState;
            /**
             * Machine-readable error code. Never set by the current dispatch: a
             * failed forward throws, carrying its code on the error's trace instead.
             */
            errorCode?: string;
            /**
             * Human-readable error detail. Never set by the current dispatch, for the
             * same reason as {@link CCTPXActions.forward} `errorCode`.
             */
            errorDetails?: string;
        };
    };
    /**
     * Re-attestation action: a fresh attestation request for a message whose
     * original attestation could not be delivered.
     */
    reAttest: CCTPXActionBase & {
        method: 'reAttest';
        values: {
            /** Nonce of the message being re-attested. */
            nonce: string;
        };
    };
}
/**
 * Valid step names for CCTPx bridge operations.
 *
 * @remarks
 * Derived from {@link CCTPXActions} so the step-name union and the action
 * map never drift.
 *
 * @example
 * ```typescript
 * const step: CCTPXStepName = 'transfer'
 * ```
 */
type CCTPXStepName = keyof CCTPXActions;

/**
 * Map a CCTPx bytes32 token id back to its known display symbol.
 *
 * The inverse of the provider's internal symbol -> id resolution: a bridge
 * resolves a symbol such as `'cirBTC'` to its canonical bytes32 id and reports
 * that id on `result.token`, dropping the symbol. This helper recovers the
 * symbol for display. It is scoped to {@link KNOWN_TOKEN_SYMBOLS} — the same
 * known set the forward resolution covers — and is keyed by network, because a
 * symbol names a separate registration on each network, whose ids are
 * unrelated.
 *
 * The lookup is best-effort by design: an arbitrary registry token, a
 * non-canonical bridge of a known symbol, or any unrecognized id has no known
 * symbol and yields `undefined`. The id is matched case-insensitively (bytes32
 * ids have no checksum casing).
 *
 * @param id - The bytes32 token id to decode (e.g. a `result.token` value).
 * @param network - The network the id belongs to (`'testnet'` or `'mainnet'`);
 *   derive it from the source chain, e.g. `chain.isTestnet ? 'testnet' :
 *   'mainnet'`.
 * @returns The matching {@link KnownTokenSymbol}, or `undefined` when `id` is
 *   not one of the known canonical ids for `network`.
 * @throws A `KitError` (`INPUT_VALIDATION_FAILED`, FATAL) when `id` is not a
 *   string or `network` is not a recognized network.
 *
 * @example
 * ```typescript
 * import { resolveToKnownTokenSymbol } from '@circle-fin/provider-cctpx'
 *
 * const result = await provider.bridge(params) // params.token === 'cirBTC'
 * const network = result.source.chain.isTestnet ? 'testnet' : 'mainnet'
 *
 * resolveToKnownTokenSymbol(result.token, network) // 'cirBTC'
 * resolveToKnownTokenSymbol('0xdeadbeef…', network) // undefined (not known)
 * ```
 */
declare function resolveToKnownTokenSymbol(id: string, network: CCTPXNetwork): KnownTokenSymbol | undefined;

/**
 * @packageDocumentation
 * @module ChainDefinitions
 *
 * This module provides a complete type system for blockchain chain definitions.
 * It supports both EVM and non‑EVM chains, token configurations, and multiple
 * versions of the Cross-Chain Transfer Protocol (CCTP). Additionally, utility types
 * are provided to extract subsets of chains (e.g. chains supporting USDC, EURC, or specific
 * CCTP versions) from a provided collection.
 *
 * All types are fully documented with TSDoc to maximize developer experience.
 */
/**
 * Represents basic information about a currency or token.
 * @category Types
 * @description Provides the essential properties of a cryptocurrency or token.
 * @example
 * ```typescript
 * const ethCurrency: Currency = {
 *   name: "Ether",
 *   symbol: "ETH",
 *   decimals: 18
 * };
 * ```
 */
interface Currency {
    /**
     * The full name of the currency.
     * @example "Ether", "USDC"
     */
    name: string;
    /**
     * The symbol or ticker of the currency.
     * @example "ETH", "USDC"
     */
    symbol: string;
    /**
     * The number of decimal places for the currency.
     * @description Defines the divisibility of the currency (e.g., 1 ETH = 10^18 wei).
     * @example 18 for ETH, 6 for USDC
     */
    decimals: number;
}
/**
 * Base information that all chain definitions must include.
 * @category Types
 * @description Provides the common properties shared by all blockchain definitions.
 * @example
