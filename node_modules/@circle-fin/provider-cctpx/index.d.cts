 * @example
 * ```typescript
 * import type { Caller } from '@core/runtime'
 *
 * const appCaller: Caller = { type: 'app', name: 'MyDApp', version: '1.0.0' }
 * const kitCaller: Caller = { type: 'kit', name: 'BridgeKit', version: '2.0.0' }
