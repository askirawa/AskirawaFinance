 *   name: 'Approve',
 *   state: 'success',
 *   txHash: '0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef',
 *   explorerUrl: 'https://etherscan.io/tx/0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef',
 * }
