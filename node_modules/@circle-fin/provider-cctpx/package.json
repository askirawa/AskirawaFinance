{
  "name": "@circle-fin/provider-cctpx",
  "version": "1.0.2",
  "description": "Circle's CCTPx provider for non-USDC cross-chain token transfers via the CrossChainTokenService",
  "keywords": [
    "circle",
    "circle-fin",
    "cctpx",
    "stablecoin",
    "sdk",
    "provider",
    "typescript",
    "cross-chain",
    "bridge",
    "bridging",
    "bridge-kit",
    "app-kit"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "sideEffects": false,
  "dependencies": {
    "zod": "3.25.67",
    "abitype": "^1.1.0",
    "@solana/web3.js": "^1.98.4",
    "pino": "10.1.0",
    "@ethersproject/abi": "^5.8.0",
    "@ethersproject/address": "^5.8.0",
    "@ethersproject/bytes": "^5.8.0",
    "@ethersproject/units": "^5.8.0",
    "bs58": "6.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": {
        "import": "./index.d.mts",
        "require": "./index.d.cts"
      },
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "files": [
    "index.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  }
}