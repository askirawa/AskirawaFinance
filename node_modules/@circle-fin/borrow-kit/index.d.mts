/**
 * Create a Borrow Kit context from the given configuration.
 *
 * Initializes a `BorrowKitContext` with any custom providers supplied via
 * `config.providers` ahead of the default `BorrowServiceProvider`
 * (mirroring `createEarnKitContext`), so a custom provider can override a
 * route without losing the built-in fallback. `config.disableAnalytics` and
 * `config.disableErrorReporting` are validated here (so invalid values fail
 * fast alongside the rest of `config`) but are not carried on the returned
 * context — the `BorrowKit` class reads them directly from `config` when
 * building its telemetry settings.
 *
 * @param config - The Borrow Kit configuration, including optional providers.
 * @returns A context containing the configured providers.
 * @throws A `KitError` with name `INPUT_VALIDATION_FAILED` when `config` is not
 *   a plain object; when `config.providers` is provided but is not an array;
 *   when `config.disableAnalytics` is provided but is not a boolean; or when
 *   `config.disableErrorReporting` is provided but is not a boolean.
 *
 * @example
 * ```typescript
 * import { createBorrowKitContext } from '@circle-fin/borrow-kit'
 *
 * const context = createBorrowKitContext()
 * ```
 */
declare function createBorrowKitContext(config?: BorrowKitConfig): BorrowKitContext;

/**
 * Validate, route, and delegate a collateral addition to a Borrow provider.
 *
 * Adding collateral is the simplest of the writes. Crediting a Morpho position
 * is permissionless, so the provider submits one atomic batch with no
 * authorization pair and no repayment leg: an optional collateral-token
 * approval followed by the Circle-signed execution. A standing partial
 * allowance is reset to zero before that approval, because the token comes from
 * the market and may reject a non-zero to non-zero approve.
 *
 * @param context - Borrow Kit context containing the Borrow Service provider.
 * @param params - Wallet context, loan ID, and the collateral to supply.
 * @returns A submitted or confirmed batch result. Confirmed results include the
 *   transaction hash and the collateral supplied.
 * @throws A `KitError` when validation, preparation, submission, or
 *   confirmation fails.
 *
 * @example
 * ```typescript
 * import {
 *   createBorrowKitContext,
 *   addCollateral,
 * } from '@circle-fin/borrow-kit'
 * import { createViemAdapterFromPrivateKey } from '@circle-fin/adapter-viem-v2/next'
 *
 * const context = createBorrowKitContext()
 * const adapter = createViemAdapterFromPrivateKey({
 *   privateKey: process.env.PRIVATE_KEY as string,
 * })
 * const result = await addCollateral(context, {
 *   from: { adapter, chain: 'Arc_Testnet' },
 *   loanId: '11111111-1111-4111-8111-111111111111',
 *   collateralAmount: '0.25',
 * })
 * ```
 */
declare function addCollateral(context: BorrowKitContext, params: AddCollateralParams): Promise<AddCollateralResult>;

/**
 * Atomically approve collateral when needed and execute a borrow.
 *
 * A request carrying `marketId` opens a loan and the service assigns its
 * identifier; a request carrying `loanId` borrows more against an existing loan
 * and takes its market from that loan.
 *
 * The ordered batch is: one exact approval per collateral token the signed
 * execution pulls (none when borrowing against collateral already supplied), a
 * `setAuthorization` grant naming the Adapter Contract as a Morpho manager,
 * `Adapter.execute`, and a matching revocation. Grant and revocation always
 * ride together, so the Adapter never holds standing authority over the
 * position between operations, and a borrow is refused outright when the owner
 * already has a standing grant.
 *
 * Each phase reports itself as it happens — `fetchParams`, `approve`,
 * `setAuthorization`, `execute` — to handlers registered through
 * `BorrowKit.on`, or on `context.actionDispatcher` directly.
 *
 * @param context - Borrow Kit context containing the Borrow Service provider.
 * @param params - Wallet context, market or loan, and amount to borrow.
 * @returns A confirmed borrow with its transaction hash, or a submitted batch
 *   identifier when the wallet cannot report the final status.
 * @throws A `KitError` when validation, preparation, submission, or confirmation fails.
 *
 * @example
 * ```typescript
 * import { borrow, createBorrowKitContext } from '@circle-fin/borrow-kit'
 * import { createViemAdapterFromPrivateKey } from '@circle-fin/adapter-viem-v2/next'
 *
 * const context = createBorrowKitContext()
 * const adapter = createViemAdapterFromPrivateKey({
 *   privateKey: process.env.PRIVATE_KEY as string,
 * })
 * const result = await borrow(context, {
 *   from: { adapter, chain: 'Arc_Testnet' },
 *   marketId: '0x1111111111111111111111111111111111111111111111111111111111111111',
 *   borrowAmount: '1000',
 * })
 * ```
 */
declare function borrow(context: BorrowKitContext, params: BorrowParams): Promise<BorrowResult>;

/**
 * Atomically repay all debt, withdraw all collateral, and revoke Morpho
 * authorization.
 *
 * @param context - Configured Borrow Kit context.
 * @param params - Wallet context, loan ID, and optional slippage bound.
 * @returns A submitted or confirmed batch result. Confirmed results include
 *   the transaction hash and, when receipt decoding succeeds, actual amounts.
 * @throws A `KitError` when parameters are invalid, atomic batching is not
 *   supported, provider data is invalid, or the transaction fails.
 *
 * @example
 * ```typescript
 * import { closeLoan, createBorrowKitContext } from '@circle-fin/borrow-kit'
 * import { createViemAdapterFromPrivateKey } from '@circle-fin/adapter-viem-v2/next'
 *
 * const context = createBorrowKitContext()
 * const adapter = createViemAdapterFromPrivateKey({
 *   privateKey: process.env.PRIVATE_KEY as string,
 * })
 * const result = await closeLoan(context, {
 *   from: { adapter, chain: 'Arc_Testnet' },
 *   loanId: '11111111-1111-4111-8111-111111111111',
 * })
 * ```
 */
declare function closeLoan(context: BorrowKitContext, params: CloseLoanParams): Promise<CloseLoanResult>;

/**
 * Discover borrow markets available on a chain.
 *
 * Validate the parameters, select a configured provider that supports the
 * chain, and delegate. Returns one filtered, sorted page of markets plus an
 * opaque `pageAfter` cursor for the next page (absent on the last page).
 * BorrowKit reads are permissionless.
 *
 * @param context - Borrow Kit context containing providers.
 * @param params - Market discovery parameters (chain plus optional filters).
 * @returns The matching markets with pagination metadata.
 * @throws {@link KitError} If params are invalid, no provider is configured, or
 *   no provider supports the requested chain.
 *
 * @example
 * ```typescript
 * import { createBorrowKitContext, exploreMarkets } from '@circle-fin/borrow-kit'
 *
 * const context = createBorrowKitContext()
 * const result = await exploreMarkets(context, {
 *   chain: 'Arc_Testnet',
 *   sortBy: 'borrowApy',
 * })
 * console.log(`Found ${result.markets.length} markets`)
 * ```
 */
declare function exploreMarkets(context: BorrowKitContext, params: ExploreMarketsParams): Promise<ExploreMarketsResult>;

/**
 * Lazily iterate every borrow market available on a chain.
 *
 * Wrap {@link exploreMarkets} in an async generator that fetches page after
 * page on demand and yields individual markets, so callers never manage the
 * `pageAfter` cursor. Pages are fetched only as iteration progresses: breaking
 * out of the loop early stops further requests.
 *
 * Parameters are validated eagerly (before the first iteration), so invalid
 * input throws at call time rather than on the first `next()`.
 *
 * Iteration follows the opaque `pagination.pageAfter` cursor and stops when it
 * is absent (the last page). If the cursor never clears, iteration throws at
 * {@link MAX_EXPLORE_PAGES} rather than looping unbounded or truncating the
 * result silently — a tripped cap means the service misbehaved.
 *
 * @param context - Borrow Kit context containing providers.
 * @param params - Discovery parameters (no `pageAfter`; the iterator owns it).
 * @returns An async generator yielding each matching market.
 * @throws {@link KitError} If params are invalid, no provider is configured,
 *   no provider supports the requested chain, or the service never exhausts the
 *   cursor within {@link MAX_EXPLORE_PAGES} pages.
 *
 * @example
 * ```typescript
 * import { createBorrowKitContext, exploreMarketsIterator } from '@circle-fin/borrow-kit'
 *
 * const context = createBorrowKitContext()
 * for await (const market of exploreMarketsIterator(context, {
 *   chain: 'Arc_Testnet',
 *   sortBy: 'borrowApy',
 * })) {
 *   console.log(`${market.protocol}: ${market.borrowApy}`)
 * }
 * ```
 */
declare function exploreMarketsIterator(context: BorrowKitContext, params: ExploreMarketsIteratorParams): AsyncGenerator<MarketInfo, void, undefined>;

/**
 * Preview adding collateral to a loan.
 *
 * Reports the fees and the resulting health of the position, plus the token the
 * addition will pull. Takes the same params as `addCollateral` without the
 * wallet context, since a quote is a read: it signs nothing and moves no funds.
 *
