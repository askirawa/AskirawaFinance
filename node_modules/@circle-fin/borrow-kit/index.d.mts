/**
 * Sign and submit a webhook callback registration (or unset) for a loan.
 *
 * This is a pure off-chain, client-signed flow: there is no on-chain
 * transaction, and configuring an API key fails locally because this API is
 * deliberately keyless. The connected wallet — which must be the loan's
 * owner — signs an EIP-712 `WebhookRegistration` intent binding the loan, the
 * exact callback URL, and a signature deadline. The Borrow Service verifies
 * the signature off-chain (including EIP-1271 for smart contract accounts)
 * before applying the registration.
 *
 * Omit `webhookUrl` (or pass `null`) to unset the loan's current webhook.
 *
 * Health-band notifications sent to `webhookUrl` are delivered at-least-once:
 * the same crossing can arrive more than once. Deduplicate on the
 * notification's `event_id`, which is stable across redeliveries of one
 * crossing.
 *
 * @typeParam TFromAdapterCapabilities - The adapter capabilities type
 * @param context - The BorrowKit context containing the configured provider
 * @param params - Webhook registration parameters with adapter context
 * @returns A promise resolving to the applied registration result
 * @throws {@link KitError} If validation fails, the adapter cannot sign
 *   typed data, or the API rejects the signature or loan id.
 *
 * @example
 * ```typescript
 * import { createBorrowKitContext, registerWebhook } from '@circle-fin/borrow-kit'
 * import { createViemAdapterFromPrivateKey } from '@circle-fin/adapter-viem-v2/next'
 *
 * const context = createBorrowKitContext()
 * const adapter = createViemAdapterFromPrivateKey({ privateKey: '0x...' })
 *
 * const result = await registerWebhook(context, {
 *   from: { adapter, chain: 'Arc_Testnet' },
 *   loanId: '11111111-1111-4111-8111-111111111111',
 *   webhookUrl: 'https://example.com/webhook',
 * })
 * console.log(`Registered webhook: ${result.webhookUrl}`)
 * ```
 */
declare function registerWebhook<TFromAdapterCapabilities extends AdapterCapabilities = AdapterCapabilities>(context: BorrowKitContext, params: RegisterWebhookParams<TFromAdapterCapabilities>): Promise<RegisterWebhookResult>;

