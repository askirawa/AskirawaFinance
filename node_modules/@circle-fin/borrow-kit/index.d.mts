/**
 * Run a failed atomic loan write again from where it stopped.
 *
 * `retry` covers `borrow`, `repay`, `addCollateral`, `closeLoan`, and
 * `withdrawCollateralRepayIfNeeded`. Each of those submits as one atomic batch, so a failed
 * attempt changed nothing on-chain and leaves no partial position to
 * reconcile. What a retry can save is the service call: when the trace carries
 * an execution whose deadline has not passed, this submits that execution
 * instead of asking for another one. Otherwise it runs the write again from
 * the start, dropping the original idempotency key when the recorded execution
 * has expired, because replaying that key would return the same expired
 * execution.
 *
 * A write whose batch confirmed is never run again, even if a later step
 * threw: the on-chain change exists, and repeating it would apply it twice.
 *
 * `claimRewards`, `registerWebhook`, and `setIntegratorConfig` are not
 * covered. An error from those operations is refused here.
 *
 * @param context - Borrow Kit context containing the Borrow Service provider.
 * @param error - The error a previous covered write threw.
 * @returns The result of the write this attempt completed.
 * @throws A `KitError` when `error` did not come from a covered write, cannot
 *   be retried, or describes a write that already confirmed.
 *
 * @example
 * ```typescript
 * import {
 *   repay,
 *   createBorrowKitContext,
 *   isRetryableError,
 *   retryBorrow,
 * } from '@circle-fin/borrow-kit'
 *
 * const context = createBorrowKitContext()
 * try {
 *   await repay(context, params)
 * } catch (error) {
 *   if (isRetryableError(error)) {
 *     await retryBorrow(context, error)
 *   }
 * }
 * ```
 */
declare function retryBorrow(context: BorrowKitContext, error: unknown): Promise<BorrowRetryResult>;

/**
 * Create or update the caller's integrator fee configuration.
 *
 * Wallet-free and API-key-scoped, and an upsert: the first call creates the
 * configuration, later calls replace it. The fee rate and its recipient must be
 * supplied together, since neither is usable without the other. To turn a fee
 * off, send `integratorFeeBps: 0` with `integratorFeeAddress: null`.
 *
 * @param context - Borrow Kit context containing providers.
 * @param params - Fee rate, its recipient, and optional per-request
 *   configuration.
 * @returns The stored configuration after the upsert.
 * @throws A `KitError` when no API key is configured, the parameters are
 *   invalid, or the provider request fails.
 *
 * @example
 * ```typescript
 * import {
 *   createBorrowKitContext,
 *   setIntegratorConfig,
 * } from '@circle-fin/borrow-kit'
 *
 * const context = createBorrowKitContext()
 * const config = await setIntegratorConfig(context, {
 *   integratorFeeBps: 25,
 *   integratorFeeAddress: '0x1111111111111111111111111111111111111111',
 *   config: { apiKey: process.env.CIRCLE_API_KEY as string },
 * })
 * ```
 */
declare function setIntegratorConfig(context: BorrowKitContext, params: SetIntegratorConfigParams): Promise<IntegratorConfig>;

