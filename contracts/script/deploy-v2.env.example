# Treasury v2 deployment inputs (ARC TESTNET ONLY: chain ID 5042002, or a local chain 31337).
# Copy to a private, git-ignored file, replace EVERY angle-bracket placeholder with a real
# address you control, then `source` it. The deploy script rejects placeholders, zero
# addresses, duplicates, and the shared Arc Studio platform wallet.
# Never put private keys here. The signer is supplied on the command line
# (--account, --ledger or --private-key) by the operator at deploy time.

# USDC token address for the target chain. Take it from src/onchain-facts.ts (getUsdc).
# The script requires the token to have code and report 6 decimals.
USDC_ADDRESS=<USDC_ADDRESS_FOR_CHAIN_5042002>

# Exactly the intended signers, comma separated, no spaces. Policy: at least 3 distinct approvers,
# each independently controlled (different people / devices).
APPROVERS=<APPROVER_1_ADDRESS>,<APPROVER_2_ADDRESS>,<APPROVER_3_ADDRESS>

# Optional. Proposers may overlap approvers. Leave empty for none.
PROPOSERS=

# Guardian: a SEPARATE address (it may not be an approver). To deliberately run without a guardian,
# leave GUARDIAN empty and set GUARDIAN_DISABLED=yes. Setting both is rejected.
GUARDIAN=<GUARDIAN_ADDRESS>
GUARDIAN_DISABLED=

# Recovery council: exactly 3 independent members and threshold 2. Members may NOT be approvers or the guardian,
# and should be different people and devices from both. The council can only install a replacement governance
# configuration after 30 days with no executed proposal, a 14 day timelock (approver veto possible) and a
# 7 day spending cooling period. It cannot move funds. These timings are fixed in the contract.
RECOVERY_COUNCIL=<COUNCIL_MEMBER_1_ADDRESS>,<COUNCIL_MEMBER_2_ADDRESS>,<COUNCIL_MEMBER_3_ADDRESS>
RECOVERY_THRESHOLD=2

# Quorum: at least 2 and at most (approver count - 1), so one lost key never locks the treasury.
# For 3 approvers this must be 2.
QUORUM=2

# Delays in seconds. Policy floors: MIN_CONFIG_DELAY >= 3600, PAYROLL_DELAY >= 300,
# CONFIG_DELAY >= MIN_CONFIG_DELAY. Maximum 14 days (1209600) each.
MIN_CONFIG_DELAY=3600
PAYROLL_DELAY=300
CONFIG_DELAY=3600

# Recurring payments module (set in the constructor, immutable).
RETRY_DELAY=3600
MAX_FAILURES=3

# Module budget (6-decimal USDC base units) and window length in seconds. Used later in the
# ModuleConfig proposal that enables the module. Keep small on testnet.
PER_TX_MAX=10000000
WINDOW_MAX=50000000
WINDOW_LENGTH=86400

# Optional. The signer address you will deploy from; prints the predicted treasury and module addresses.
DEPLOYER_ADDRESS=

# Required to actually deploy. Anything else prints the resolved config and stops.
CONFIRM_DEPLOY=
