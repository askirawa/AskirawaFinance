# Treasury v2 deployment inputs (TESTNET ONLY in this release).
# Copy to a private, git-ignored file, replace EVERY angle-bracket placeholder with a real
# address you control, then `source` it. The deploy script rejects placeholders, zero
# addresses, duplicates, and the shared Arc Studio platform wallet.
# Never put private keys here. The signer is supplied on the command line
# (--account, --ledger or --private-key) by the operator at deploy time.

# USDC token address for the target chain. Take it from src/onchain-facts.ts (getUsdc).
USDC_ADDRESS=<USDC_TOKEN_ADDRESS_FOR_TARGET_CHAIN>

# At least 2 approvers (comma separated, no spaces).
APPROVERS=<APPROVER_1_ADDRESS>,<APPROVER_2_ADDRESS>,<APPROVER_3_ADDRESS>

# Optional. Proposers may overlap approvers. Leave empty for none.
PROPOSERS=<PROPOSER_1_ADDRESS>

# Optional. Leave empty to disable the guardian.
GUARDIAN=<GUARDIAN_ADDRESS>

# Quorum, minimum 2 and at most the number of approvers.
QUORUM=2

# Delays in seconds.
MIN_CONFIG_DELAY=86400
PAYROLL_DELAY=3600
CONFIG_DELAY=86400

# Recurring payments module.
RETRY_DELAY=21600
MAX_FAILURES=5

# Module budget (6-decimal USDC base units) and window length in seconds.
# These values are used later in the ModuleConfig proposal that enables the module.
PER_TX_MAX=<PER_PAYMENT_CAP_BASE_UNITS>
WINDOW_MAX=<PER_WINDOW_CAP_BASE_UNITS>
WINDOW_LENGTH=86400

# Required to actually deploy. Anything else prints the resolved config and stops.
CONFIRM_DEPLOY=no
